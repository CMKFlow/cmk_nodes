{
  "schemaVersion": 1,
  "requiredFiles": [
    "__init__.py",
    "cmk_mappings.py",
    "cmk_distribution.py",
    "pyproject.toml",
    "requirements.txt",
    "web/flow_node_metadata.json",
    "web/browser_content_en.json"
  ],
  "forbiddenArtifactPaths": [
    ".git",
    ".ruff_cache",
    "_cmk_backups",
    "tests"
  ],
  "releaseFeatures": [
    {
      "name": "ContentGuard distribution policy",
      "requiredFiles": [
        "cmk_distribution.py",
        "engine/content_guard.py"
      ],
      "requiredMarkers": {
        "cmk_distribution.py": [
          "DISTRIBUTION_MODE =",
          "CONTENT_GUARD_EXECUTION_KEY",
          "if distribution_mode() == RELEASE:",
          "return True"
        ],
        "pipe/cmk_pipe_image.py": [
          "content_guard_enabled",
          "cmk_baseline_visible"
        ],
        "nodes/video/face_swap_video.py": [
          "content_guard_prompt_token",
          "content_guard_enabled=content_guard_enabled"
        ],
        "nodes/video/face_swap_video_loader.py": [
          "content_guard_control_visible",
          "segments[CONTENT_GUARD_PROCESS_KEY] = content_guard_enabled"
        ],
        "web/js/cmk_flow_start_guidance_v51.js": [
          "routeContentGuardAtExecution",
          "contentGuardConsumerIsActive",
          "delete startNode.inputs[CONTENT_GUARD_WIDGET]",
          "node.inputs[CONTENT_GUARD_EXECUTION_INPUT] = requested"
        ]
      }
    },
    {
      "name": "CMK Flow Image Resize",
      "nodeClass": "CMKImageResize",
      "requiredFiles": [
        "nodes/image/image_resize.py",
        "web/js/cmk_image_resize_ui.js",
        "web/assets/previews/CMK Flow · Image Resize.png"
      ],
      "requiredMarkers": {
        "cmk_mappings.py": [
          "from .nodes.image.image_resize import CMKImageResize",
          "\"CMKImageResize\": CMKImageResize",
          "\"CMKImageResize\": \"CMK Flow · Image Resize\""
        ],
        "pipe/cmk_sampler_prepare.py": [
          "ensure_sdxl_text_encoder",
          "clip, _ = ensure_sdxl_text_encoder(MODEL)"
        ],
        "web/js/cmk_flow_browser.js": [
          "selected.features, \"Noch keine Funktionsübersicht hinterlegt\""
        ]
      },
      "requiredJsonKeys": {
        "web/flow_node_metadata.json": "nodes.CMKImageResize",
        "web/browser_content_en.json": "flows.CMKImageResize"
      }
    }
  ]
}
